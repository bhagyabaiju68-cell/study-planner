{
  "name": "study-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build && tsx src/server.ts",
    "build": "tsc --project tsconfig.frontend.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint '**/*.{ts,js}'",
    "lint-fix": "eslint --fix '**/*.{ts,js}'",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.frontend.json --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
